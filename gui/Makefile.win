# reposync-gui (Windows): SDL3 self-drawn UI + libssh2 backend.
#   Zero GPL/LGPL: SDL3 (zlib), SDL3_ttf (zlib), libssh2 (BSD).
#
# Required dependencies (MSYS2):
#   pacman -S mingw-w64-x86_64-gcc mingw-w64-x86_64-sdl3 \
#             mingw-w64-x86_64-sdl3-ttf mingw-w64-x86_64-libssh2 \
#             mingw-w64-x86_64-sqlite3
#
# Usage:
#   make -f Makefile.win LIBSSH2_ROOT=C:/msys64/mingw64
#     (or leave LIBSSH2_ROOT at the default below)
#
# The produced reposync-gui.exe needs, next to it or on PATH:
#   SDL3.dll, SDL3_ttf.dll, libssh2-1.dll (+ their deps: libfreetype-6,
#   libpng16-16, libcrypto-3-x64, zlib1, libwinpthread-1, libgcc_s_seh-1).
# Copy them from <msys2>/mingw64/bin.

LIBSSH2_ROOT ?= C:/msys64/mingw64

CC ?= x86_64-w64-mingw32-gcc
CFLAGS ?= -O2 -Wall -Wextra -std=gnu99 -D_WIN32_WINNT=0x0601
CFLAGS += -I$(LIBSSH2_ROOT)/include
LDLIBS  = -L$(LIBSSH2_ROOT)/lib -lSDL3 -lSDL3_ttf -lssh2 -lsqlite3 \
          -lws2_32 -lcrypt32 -mwindows

BIN = reposync-gui.exe
SRCS = main.c app.c backend_local.c backend_ssh2.c ui_sdl.c
# Separate object suffix so Windows builds never clobber the ELF .o files
# produced by the Linux Makefile in the same directory.
OBJS = $(SRCS:.c=.wino)

all: $(BIN)

$(BIN): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $(OBJS) $(LDLIBS)
	# Some GCC/MinGW linkers emit a .comment section with a bogus VMA that
	# makes the Windows loader reject the exe; strip it.
	objcopy --remove-section .comment $@ $@

%.wino: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(BIN) $(SRCS:.c=.o)

.PHONY: all clean
